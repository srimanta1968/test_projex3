{
  "endpoint": "/api/billing/:record_id",
  "method": "GET",
  "taskId": "c100a8f7-82a7-4f57-9f58-da7fdc1cdfff",
  "requiresAuth": true,
  "priority": 66,
  "dependsOn": ["POST /api/auth/register", "POST /api/payments"],
  "testCases": [
    {
      "name": "Get billing record by ID",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "params": {
        "record_id": "{{cache:payments.scenario.response.data.payment.id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "record": {
            "id": "{{cache:payments.scenario.response.data.payment.id}}"
          }
        }
      }
    },
    {
      "name": "Get billing record with invalid ID returns 404",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "params": {
        "record_id": "00000000-0000-0000-0000-000000000000"
      },
      "expectedStatus": 404,
      "expectedResponse": {
        "success": false,
        "error": "Billing record not found"
      }
    }
  ]
}
