{
  "endpoint": "ws://localhost:3000/ws",
  "type": "websocket",
  "description": "WebSocket server for real-time updates",
  "requiresAuth": true,
  "tags": ["websocket", "realtime", "notifications"],
  "events": [
    {
      "type": "connected",
      "direction": "server_to_client",
      "description": "Sent when client connects to WebSocket server",
      "payload": {
        "message": "Connected to Quick Taxi WebSocket server"
      }
    },
    {
      "type": "authenticate",
      "direction": "client_to_server",
      "description": "Client sends JWT token for authentication",
      "payload": {
        "type": "authenticate",
        "token": "<JWT_TOKEN>"
      }
    },
    {
      "type": "authenticated",
      "direction": "server_to_client",
      "description": "Sent when client is successfully authenticated",
      "payload": {
        "message": "Authentication successful",
        "userId": "123e4567-e89b-12d3-a456-426614174000"
      }
    },
    {
      "type": "new_ride_offer",
      "direction": "server_to_client",
      "description": "Broadcast when a new ride offer is created",
      "payload": {
        "offer_id": "123e4567-e89b-12d3-a456-426614174000",
        "driver_id": "123e4567-e89b-12d3-a456-426614174001",
        "pickup_location": "Downtown",
        "dropoff_location": "Airport",
        "available_seats": 3
      }
    },
    {
      "type": "new_ride_request",
      "direction": "server_to_client",
      "description": "Sent to matching drivers when a new ride request is created",
      "payload": {
        "request_id": "123e4567-e89b-12d3-a456-426614174000",
        "rider_id": "123e4567-e89b-12d3-a456-426614174002",
        "pickup_location": "Train Station",
        "dropoff_location": "Mall"
      }
    },
    {
      "type": "match_created",
      "direction": "server_to_client",
      "description": "Sent to both rider and driver when a match is created",
      "payload": {
        "match_id": "123e4567-e89b-12d3-a456-426614174000",
        "offer_id": "123e4567-e89b-12d3-a456-426614174001",
        "request_id": "123e4567-e89b-12d3-a456-426614174002",
        "status": "pending"
      }
    },
    {
      "type": "match_accepted",
      "direction": "server_to_client",
      "description": "Sent when a match is accepted",
      "payload": {
        "match_id": "123e4567-e89b-12d3-a456-426614174000",
        "status": "active"
      }
    },
    {
      "type": "match_completed",
      "direction": "server_to_client",
      "description": "Sent when a ride is completed",
      "payload": {
        "match_id": "123e4567-e89b-12d3-a456-426614174000",
        "status": "completed"
      }
    },
    {
      "type": "notification",
      "direction": "server_to_client",
      "description": "General notification message",
      "payload": {
        "title": "Notification Title",
        "message": "Notification body text"
      }
    }
  ],
  "testCases": [
    {
      "name": "Connect without authentication",
      "steps": [
        "Connect to WebSocket",
        "Receive 'connected' message",
        "Send non-authenticate message",
        "Receive 'error' message about not authenticated"
      ],
      "expectedResponse": {
        "type": "error",
        "payload": {
          "message": "Not authenticated. Send authentication token first."
        }
      }
    },
    {
      "name": "Connect and authenticate successfully",
      "steps": [
        "Connect to WebSocket",
        "Receive 'connected' message",
        "Send authenticate message with valid JWT",
        "Receive 'authenticated' message"
      ],
      "expectedResponse": {
        "type": "authenticated",
        "payload": {
          "message": "Authentication successful"
        }
      }
    }
  ]
}
