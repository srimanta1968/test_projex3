{
  "endpoint": "/api/users/send-phone-verification",
  "method": "POST",
  "description": "Send SMS verification code to user's phone number",
  "requestBody": {
    "phone": {
      "type": "string",
      "required": true,
      "inputType": "dynamic",
      "description": "User's phone number to verify",
      "validation": {
        "pattern": "^[+]?[0-9]{10,15}$"
      }
    }
  },
  "expectedResponse": {
    "success": {
      "statusCode": 200,
      "body": {
        "success": true,
        "message": "Verification code sent successfully"
      }
    }
  },
  "errorResponses": [
    {
      "statusCode": 400,
      "condition": "Invalid phone format",
      "body": {
        "success": false,
        "error": "Invalid phone number format"
      }
    },
    {
      "statusCode": 404,
      "condition": "User not found",
      "body": {
        "success": false,
        "error": "User not found"
      }
    },
    {
      "statusCode": 409,
      "condition": "Phone already verified",
      "body": {
        "success": false,
        "error": "Phone already verified"
      }
    },
    {
      "statusCode": 429,
      "condition": "Too many requests",
      "body": {
        "success": false,
        "error": "Too many verification attempts. Please try again later."
      }
    }
  ],
  "testCases": [
    {
      "name": "Happy path - verification code sent",
      "type": "happy_path",
      "input": {
        "phone": "+1234567890"
      },
      "expectedOutput": {
        "statusCode": 200,
        "body": {
          "success": true,
          "message": "Verification code sent successfully"
        }
      }
    }
  ]
}
