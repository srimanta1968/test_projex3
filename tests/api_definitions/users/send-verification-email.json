{
  "endpoint": "/api/users/send-verification-email",
  "method": "POST",
  "description": "Send email verification link to user's email address",
  "requestBody": {
    "email": {
      "type": "string",
      "required": true,
      "inputType": "dynamic",
      "description": "User's email address to verify",
      "validation": {
        "format": "email",
        "maxLength": 255
      }
    }
  },
  "expectedResponse": {
    "success": {
      "statusCode": 200,
      "body": {
        "success": true,
        "message": "Verification email sent successfully"
      }
    }
  },
  "errorResponses": [
    {
      "statusCode": 400,
      "condition": "Invalid email format",
      "body": {
        "success": false,
        "error": "Invalid email format"
      }
    },
    {
      "statusCode": 404,
      "condition": "User not found",
      "body": {
        "success": false,
        "error": "User not found"
      }
    },
    {
      "statusCode": 409,
      "condition": "Email already verified",
      "body": {
        "success": false,
        "error": "Email already verified"
      }
    }
  ],
  "testCases": [
    {
      "name": "Happy path - verification email sent",
      "type": "happy_path",
      "input": {
        "email": "john.doe@example.com"
      },
      "expectedOutput": {
        "statusCode": 200,
        "body": {
          "success": true,
          "message": "Verification email sent successfully"
        }
      }
    }
  ]
}
