{
  "endpoint": "/api/users/register",
  "method": "POST",
  "description": "Register a new user with email, phone, name, and password",
  "requestBody": {
    "name": {
      "type": "string",
      "required": true,
      "inputType": "dynamic",
      "description": "User's full name",
      "validation": {
        "minLength": 2,
        "maxLength": 255
      }
    },
    "email": {
      "type": "string",
      "required": true,
      "inputType": "dynamic",
      "description": "User's email address",
      "validation": {
        "format": "email",
        "maxLength": 255
      }
    },
    "phone": {
      "type": "string",
      "required": true,
      "inputType": "dynamic",
      "description": "User's phone number",
      "validation": {
        "pattern": "^[+]?[0-9]{10,15}$",
        "maxLength": 255
      }
    },
    "password": {
      "type": "string",
      "required": true,
      "inputType": "dynamic",
      "description": "User's password",
      "validation": {
        "minLength": 8,
        "maxLength": 255
      }
    }
  },
  "expectedResponse": {
    "success": {
      "statusCode": 201,
      "body": {
        "success": true,
        "data": {
          "id": "uuid",
          "name": "string",
          "email": "string",
          "phone": "string",
          "created_at": "timestamp"
        },
        "message": "User registered successfully"
      }
    }
  },
  "errorResponses": [
    {
      "statusCode": 400,
      "condition": "Invalid input data",
      "body": {
        "success": false,
        "error": {
          "fields": {
            "email": "Invalid email format",
            "password": "Password must be at least 8 characters"
          }
        }
      }
    },
    {
      "statusCode": 409,
      "condition": "Email already exists",
      "body": {
        "success": false,
        "error": "Email already registered"
      }
    }
  ],
  "testCases": [
    {
      "name": "Happy path - successful user registration",
      "type": "happy_path",
      "input": {
        "name": "John Doe",
        "email": "john.doe@example.com",
        "phone": "+1234567890",
        "password": "SecurePass123"
      },
      "expectedOutput": {
        "statusCode": 201,
        "body": {
          "success": true,
          "message": "User registered successfully"
        }
      }
    }
  ]
}
