{
  "endpoint": "/api/rides",
  "method": "POST",
  "description": "Create a new ride for the authenticated user",
  "requiresAuth": true,
  "tags": ["rides", "create"],
  "testCases": [
    {
      "name": "Happy path - successful ride creation",
      "payload": {
        "pickup_location": "{{static:123 Main Street, Downtown}}",
        "dropoff_location": "{{static:456 Oak Avenue, Uptown}}"
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "success": true,
        "message": "Ride created successfully",
        "data": {
          "id": "uuid",
          "user_id": "uuid",
          "pickup_location": "123 Main Street, Downtown",
          "dropoff_location": "456 Oak Avenue, Uptown",
          "status": "pending",
          "created_at": "2024-01-15T10:30:00Z",
          "updated_at": "2024-01-15T10:30:00Z"
        }
      }
    }
  ]
}
