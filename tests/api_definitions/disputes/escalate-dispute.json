{
  "endpoint": "/api/disputes/:id/escalate",
  "method": "POST",
  "description": "Escalate a dispute for priority review",
  "requiresAuth": true,
  "tags": ["disputes", "escalate"],
  "testCases": [
    {
      "name": "Happy path - escalate dispute",
      "pathParams": {
        "id": "123e4567-e89b-12d3-a456-426614174000"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "id": "123e4567-e89b-12d3-a456-426614174000",
          "user_id": "user-id-from-token",
          "dispute_type": "service",
          "status": "escalated",
          "reason": "Poor service quality during ride",
          "description": "Driver was late and took a longer route",
          "updated_at": "2024-01-15T12:00:00Z",
          "messages": [
            {
              "id": "msg-system",
              "dispute_id": "123e4567-e89b-12d3-a456-426614174000",
              "message": "This dispute has been escalated for priority review.",
              "is_admin": true,
              "created_at": "2024-01-15T12:00:00Z"
            }
          ]
        }
      }
    }
  ]
