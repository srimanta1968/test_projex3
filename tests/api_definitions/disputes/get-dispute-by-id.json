{
  "endpoint": "/api/disputes/:id",
  "method": "GET",
  "description": "Get a specific dispute by ID with all messages",
  "requiresAuth": true,
  "tags": ["disputes", "detail"],
  "testCases": [
    {
      "name": "Happy path - get dispute details",
      "pathParams": {
        "id": "123e4567-e89b-12d3-a456-426614174000"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "id": "123e4567-e89b-12d3-a456-426614174000",
          "user_id": "user-id-from-token",
          "dispute_type": "service",
          "status": "open",
          "reason": "Poor service quality during ride",
          "description": "Driver was late and took a longer route",
          "evidence_urls": [],
          "resolution": null,
          "created_at": "2024-01-15T10:30:00Z",
          "updated_at": "2024-01-15T10:30:00Z",
          "user_name": "John Doe",
          "messages": [
            {
              "id": "msg-123",
              "dispute_id": "123e4567-e89b-12d3-a456-426614174000",
              "user_id": "user-id",
              "message": "I would like a refund for the extra fare charged.",
              "is_admin": false,
              "created_at": "2024-01-15T10:35:00Z",
              "user_name": "John Doe"
            }
          ],
          "message_count": 1
        }
      }
    }
  ]
}
