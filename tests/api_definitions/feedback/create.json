{
  "endpoint": "/api/feedback",
  "method": "POST",
  "taskId": "e9bc152c-ebf2-4ada-803a-c1b2c61fd609",
  "requiresAuth": true,
  "priority": 35,
  "dependsOn": ["POST /api/auth/register"],
  "captureResponse": {
    "feedback.create.response.data.feedback.id": "data.feedback.id"
  },
  "testCases": [
    {
      "name": "Submit user feedback",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "rating": 5,
        "comments": "{{dynamic:sentence}}"
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "success": true,
        "data": {
          "feedback": {
            "id": "string",
            "user_id": "string",
            "rating": "number",
            "comments": "string"
          }
        }
      }
    }
  ]
}
