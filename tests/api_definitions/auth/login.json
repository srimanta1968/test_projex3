{
  "endpoint": "/api/auth/login",
  "method": "POST",
  "requiresAuth": false,
  "description": "User login endpoint - returns JWT token",
  "testCases": [{
    "name": "Login with registered user",
    "payload": {
      "email": "{{cache:auth.email}}",
      "password": "{{cache:auth.password}}"
    },
    "expectedStatus": 200,
    "cacheResponse": {
      "auth.token": "$.data.token"
    }
  }]
}
