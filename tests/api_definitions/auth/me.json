{
  "endpoint": "/api/auth/me",
  "method": "GET",
  "description": "Get current authenticated user's information",
  "headers": {
    "Authorization": {
      "type": "string",
      "required": true,
      "format": "Bearer {token}",
      "description": "JWT token obtained from login"
    }
  },
  "requestBody": null,
  "expectedResponse": {
    "success": {
      "statusCode": 200,
      "body": {
        "success": true,
        "data": {
          "id": "uuid",
          "name": "string",
          "email": "string",
          "phone": "string",
          "email_verified": "boolean",
          "phone_verified": "boolean"
        }
      }
    }
  },
  "errorResponses": [
    {
      "statusCode": 401,
      "condition": "No token provided or invalid token",
      "body": {
        "success": false,
        "error": "Authentication required"
      }
    }
  ],
  "testCases": [
    {
      "name": "Happy path - get current user",
      "type": "happy_path",
      "headers": {
        "Authorization": "Bearer valid-jwt-token"
      },
      "expectedOutput": {
        "statusCode": 200,
        "body": {
          "success": true
        }
      }
    }
  ]
}
