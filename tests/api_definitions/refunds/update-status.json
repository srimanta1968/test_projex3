{
  "endpoint": "/api/refunds/:refund_id/status",
  "method": "PUT",
  "taskId": "5f40c35d-2465-4ccf-a1c1-aa3ecf5d3968",
  "description": "Update refund status (approve/reject)",
  "requiresAuth": true,
  "priority": 72,
  "dependsOn": ["POST /api/auth/register", "POST /api/refunds"],
  "testCases": [
    {
      "name": "Approve a pending refund",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "status": "{{static:approved}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "refund": {
            "status": "approved"
          }
        }
      }
    }
  ],
  "businessRules": [
    "Only pending refunds can be approved or rejected",
    "Valid status values are 'approved' and 'rejected'",
    "User can only update their own refunds"
  ]
}
