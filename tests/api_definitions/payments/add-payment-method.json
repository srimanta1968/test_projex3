{
  "endpoint": "/api/payments/methods",
  "method": "POST",
  "description": "Add a new payment method for the authenticated user",
  "requiresAuth": true,
  "tags": ["payments", "methods", "create"],
  "testCases": [
    {
      "name": "Happy path - add payment method",
      "payload": {
        "card_last_four": "4242",
        "expiry_month": 12,
        "expiry_year": 2025,
        "cardholder_name": "John Doe"
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "success": true,
        "data": {
          "id": "abc12345-e89b-12d3-a456-426614174003",
          "card_last_four": "4242",
          "expiry_date": "2025-12",
          "cardholder_name": "John Doe",
          "created_at": "2024-01-15T10:30:00Z"
        }
      }
    }
  ]
}
