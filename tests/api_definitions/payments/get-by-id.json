{
  "endpoint": "/api/payments/:payment_id",
  "method": "GET",
  "taskId": "ed5723fb-46e0-4feb-8b27-76bacb61ff2e",
  "requiresAuth": true,
  "priority": 63,
  "dependsOn": ["POST /api/payments"],
  "testCases": [
    {
      "name": "Get payment by ID",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "params": {
        "payment_id": "{{cache:payments.scenario.response.data.payment.id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "payment": {
            "id": "{{cache:payments.scenario.response.data.payment.id}}"
          }
        }
      }
    },
    {
      "name": "Get payment with invalid ID returns 404",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "params": {
        "payment_id": "00000000-0000-0000-0000-000000000000"
      },
      "expectedStatus": 404,
      "expectedResponse": {
        "success": false,
        "error": "Payment not found"
      }
    }
  ]
}
