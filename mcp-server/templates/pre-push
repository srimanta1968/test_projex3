#!/bin/bash

# ProjexLight MCP Pre-Push Hook
# Triggers API testing and component duplication detection before git push
# This hook is installed automatically by the MCP server on startup

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
MCP_SERVER_URL="${MCP_SERVER_URL:-http://localhost:8766}"
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo ".")"

echo -e "${BLUE}🚀 ProjexLight Pre-Push Hook${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# Check if MCP server is running
if ! curl -s "${MCP_SERVER_URL}/health" > /dev/null 2>&1; then
    echo -e "${YELLOW}⚠️  MCP server not running at ${MCP_SERVER_URL}${NC}"
    echo -e "${YELLOW}   Skipping API tests and component scanning${NC}"
    echo -e "${YELLOW}   Start MCP server: cd mcp-server && docker-compose up -d${NC}"
    exit 0
fi

echo -e "${GREEN}✓ MCP server is running${NC}"

# Get changed files in this push (optimize scanning)
echo -e "\n${BLUE}📋 Identifying changed files...${NC}"
REMOTE_BRANCH=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || echo "origin/main")
CHANGED_FILES=$(git diff --name-only ${REMOTE_BRANCH}..HEAD 2>/dev/null || echo "")

if [ -z "$CHANGED_FILES" ]; then
    echo -e "${YELLOW}⚠️  No changed files detected${NC}"
    echo -e "${YELLOW}   Skipping API tests and component scanning${NC}"
    exit 0
fi

# Count unique changed files
FILE_COUNT=$(echo "$CHANGED_FILES" | wc -l)
echo -e "${GREEN}✓ Found ${FILE_COUNT} changed files${NC}"

# Convert to JSON array
CHANGED_FILES_JSON=$(echo "$CHANGED_FILES" | jq -R -s -c 'split("\n") | map(select(length > 0))')

# Trigger API testing (OPTIMIZED - only scans changed files)
echo -e "\n${BLUE}🧪 Running API tests on changed files...${NC}"

API_TEST_RESULT=$(curl -s -X POST "${MCP_SERVER_URL}/api/test" \
    -H "Content-Type: application/json" \
    -d "{
        \"project_root\": \"${PROJECT_ROOT}\",
        \"triggered_by\": \"git_push\",
        \"changed_files\": ${CHANGED_FILES_JSON}
    }" 2>&1)

if [ $? -eq 0 ]; then
    # Parse test results
    TOTAL_APIS=$(echo "$API_TEST_RESULT" | jq -r '.summary.totalAPIs // 0' 2>/dev/null || echo "0")
    PASSED=$(echo "$API_TEST_RESULT" | jq -r '.summary.passedAPIs // 0' 2>/dev/null || echo "0")
    FAILED=$(echo "$API_TEST_RESULT" | jq -r '.summary.failedAPIs // 0' 2>/dev/null || echo "0")
    DUPLICATES=$(echo "$API_TEST_RESULT" | jq -r '.summary.duplicateAPIs // 0' 2>/dev/null || echo "0")

    echo -e "${GREEN}✓ API Testing completed${NC}"
    echo -e "  Total APIs: ${TOTAL_APIS}"
    echo -e "  Passed: ${GREEN}${PASSED}${NC}"

    if [ "$FAILED" -gt 0 ]; then
        echo -e "  Failed: ${RED}${FAILED}${NC}"
    fi

    if [ "$DUPLICATES" -gt 0 ]; then
        echo -e "  ${YELLOW}⚠️  Duplicate APIs detected: ${DUPLICATES}${NC}"
    fi

    # Optionally fail push if tests failed (disabled by default)
    if [ "$FAILED" -gt 0 ] && [ "${PROJEXLIGHT_FAIL_ON_TEST_FAILURE:-false}" = "true" ]; then
        echo -e "\n${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${RED}❌ Push rejected: API tests failed${NC}"
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "\n${YELLOW}Fix the failing tests or disable with:${NC}"
        echo -e "  export PROJEXLIGHT_FAIL_ON_TEST_FAILURE=false"
        exit 1
    fi
else
    echo -e "${YELLOW}⚠️  API testing failed or skipped${NC}"
fi

# Trigger component duplication scan (OPTIMIZED - only scans changed files)
echo -e "\n${BLUE}🔍 Scanning for duplicate components in changed files...${NC}"

COMPONENT_SCAN_RESULT=$(curl -s -X POST "${MCP_SERVER_URL}/api/components/scan" \
    -H "Content-Type: application/json" \
    -d "{
        \"project_root\": \"${PROJECT_ROOT}\",
        \"triggered_by\": \"git_push\",
        \"changed_files\": ${CHANGED_FILES_JSON}
    }" 2>&1)

if [ $? -eq 0 ]; then
    DUPLICATES_FOUND=$(echo "$COMPONENT_SCAN_RESULT" | jq -r '.summary.duplicateComponentsFound // 0' 2>/dev/null || echo "0")

    echo -e "${GREEN}✓ Component scan completed${NC}"

    if [ "$DUPLICATES_FOUND" -gt 0 ]; then
        echo -e "  ${YELLOW}⚠️  Similar components found: ${DUPLICATES_FOUND}${NC}"
        echo -e "  ${YELLOW}   Review details in Leadership Dashboard${NC}"
    else
        echo -e "  No duplicate components detected"
    fi
else
    echo -e "${YELLOW}⚠️  Component scan failed or skipped${NC}"
fi

echo -e "\n${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✅ Pre-push checks completed${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}📊 View detailed results in Leadership Dashboard${NC}"
echo -e ""

exit 0
