# Claude Ignore File
# Files and directories listed here will be inaccessible to Claude
# This protects sensitive data from being read or modified by AI

# ═══════════════════════════════════════════════════════════
# ENVIRONMENT & SECRETS (CRITICAL - DO NOT REMOVE)
# ═══════════════════════════════════════════════════════════

# Environment files
.env
.env.*
!.env.example

# API Keys & Secrets
secrets/
credentials/
*.key
*.pem
*.p12
*.pfx

# ═══════════════════════════════════════════════════════════
# PROTECTED CONFIGURATION (DO NOT MODIFY)
# ═══════════════════════════════════════════════════════════

# Protected context files (read-only)
.claude/context/

# Protected instructions (read-only)
.claude/instructions/

# ═══════════════════════════════════════════════════════════
# DEPENDENCIES & BUILD OUTPUT
# ═══════════════════════════════════════════════════════════

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/
*.tsbuildinfo

# ═══════════════════════════════════════════════════════════
# VERSION CONTROL
# ═══════════════════════════════════════════════════════════

.git/
.gitignore

# ═══════════════════════════════════════════════════════════
# IDE & EDITOR
# ═══════════════════════════════════════════════════════════

.vscode/
.idea/
*.swp
*.swo
*~

# ═══════════════════════════════════════════════════════════
# TESTING & COVERAGE
# ═══════════════════════════════════════════════════════════

coverage/
.nyc_output/
*.lcov

# ═══════════════════════════════════════════════════════════
# LOGS
# ═══════════════════════════════════════════════════════════

logs/
*.log
